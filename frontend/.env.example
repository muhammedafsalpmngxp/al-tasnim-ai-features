# Frontend environment template. Copy to frontend/.env if you need to override.
# No backend secret is ever exposed to the browser.

# Base URL the browser uses for API calls.
# Leave empty in development to use the Vite dev-server proxy below.
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api during development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
