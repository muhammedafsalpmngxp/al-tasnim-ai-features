# Days ahead of a well's pegging / FLAF / rig-on / rig-off deadline at which it
# starts showing up as an "upcoming" priority milestone alert.
MILESTONE_PRIORITY_WINDOW_DAYS=7
# Maximum already-overdue milestones returned in the capped detail list (the
# true total is always reported separately as overdue_count).
MILESTONE_OVERDUE_DISPLAY_LIMIT=20

# ---- LLM (explanation layer only) ----
# provider is "openai" or "groq" -- both speak the same chat-completions
# protocol, so switching is just these values, never a code change.
LLM_PROVIDER=openai
LLM_API_KEY=
# e.g. gpt-4o-mini for openai, or openai/gpt-oss-120b for groq
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.2
