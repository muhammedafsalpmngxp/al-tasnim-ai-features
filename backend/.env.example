# Model for the front page's whole-day AI summary only (one call per day,
# over every live well). Blank uses LLM_MODEL. Per-well and per-task
# summaries always use LLM_MODEL.
LLM_DAY_MODEL=
# Completion budget for that call. Reasoning models (gpt-5 family, o-series)
# spend part of it thinking, so give them more than LLM_MAX_TOKENS.
LLM_DAY_MAX_TOKENS=4000
