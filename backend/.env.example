# ---- Authoritative usage sync (llm_usage_tracker.py, project root) ----
# The per-call expense log only ever sees calls made through this running
# application -- not the test suite (which disables it on purpose), and not
# anything else spending tokens on the same key. `python llm_usage_tracker.py
# sync` pulls what OpenAI actually billed into the same workbook.
#
# This must be an ADMIN key (Organization -> Admin keys, starts sk-admin-),
# NOT the LLM_API_KEY above: organisation usage and cost are admin-scoped
# endpoints and refuse an ordinary project key. Leave blank to skip the sync.
OPENAI_ADMIN_KEY=
# How many days back each sync pulls, unless --days says otherwise.
OPENAI_USAGE_DAYS=30
# Comma-separated project ids to limit the sync to; blank means the whole
# organisation.
OPENAI_USAGE_PROJECT_IDS=
# Where the organisation usage/cost endpoints live.
OPENAI_USAGE_BASE_URL=https://api.openai.com/v1

# ---- Development only ----
# Must stay false. Never substitute mock data for production data.
USE_MOCK_DATA=false
