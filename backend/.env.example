=======

# ---- DYNAMIC_DB ------------------------------------------------------------
# The schema allowlist, the reasoning model, and every other dynamic-schema
# setting now live entirely in ../DYNAMIC_DB/.env -- that project is
# independently configured and independently runnable, and is never given a
# copy of this application's own settings. See DYNAMIC_DB/.env.example.
# This application only ever talks to it through app/dynamic_client.py.

# ---- Agents (agentic edition only) ----------------------------------------
# Each role's model. Blank: planner and day writer use LLM_DAY_MODEL, the
# writer and verifier use LLM_MODEL.
AGENT_PLANNER_MODEL=
AGENT_DAY_WRITER_MODEL=
AGENT_WRITER_MODEL=
AGENT_VERIFIER_MODEL=
# The deterministic verifier (every number checked against the evidence)
# always runs. true adds a model's second opinion on each draft -- more
# tokens per answer.
AGENT_LLM_VERIFY=false
# Limits on one agent run.
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_REVISIONS=2
AGENT_PLANNER_MAX_TOKENS=2000
AGENT_WRITER_MAX_TOKENS=900
# Days before a milestone deadline at which a well's open work is reported as
# "open work before an upcoming deadline". Blank uses MILESTONE_PRIORITY_WINDOW_DAYS.
AGENT_DEADLINE_WINDOW_DAYS=

# ---- Oman field map ---------------------------------------------------------
# Approximate field coordinates; blank uses app/config/oman_field_coordinates.json.
FIELD_MAP_COORDINATES_FILE=
# Seconds the field summary is reused before SQL is read again.
FIELD_MAP_CACHE_TTL_SECONDS=600

# ---- Oman field map basemaps --------------------------------------------------
# Satellite imagery offered on the map: esri | custom | none. The standard
# English street map (Esri World Street Map) is always offered as the fallback.
#
# LICENSING -- read before production use. Esri World Imagery and its label
# layer are licensed under the Esri Master License Agreement and require
# attribution (shown on the map). With MAP_ESRI_API_KEY blank the map uses
# Esri's public MapServer tiles, which Esri's terms do not grant for
# unrestricted commercial use. For production, either confirm the
# organisation's existing ArcGIS licence covers it, or create an ArcGIS
# Location Platform account (free tier: 2M basemap tiles/month) and set the key.
MAP_SATELLITE_PROVIDER=esri
# ArcGIS Location Platform API key with the basemap privilege. Set -> the
# licensed Static Basemap Tiles service (imagery + English labels + streets).
# This key reaches the browser inside tile URLs, as Esri designs it: restrict
# it to basemaps and to this site's HTTP referrer in the ArcGIS portal.
MAP_ESRI_API_KEY=
# Label language for the keyed service (en, fr, de, ...).
MAP_LABELS_LANGUAGE=en
# Basemap the page opens on: satellite | standard.
MAP_DEFAULT_BASEMAP=satellite
# MAP_SATELLITE_PROVIDER=custom only: a licensed imagery tile template and its
# attribution, plus an optional English label overlay.
MAP_CUSTOM_SATELLITE_URL=
MAP_CUSTOM_SATELLITE_ATTRIBUTION=
MAP_CUSTOM_SATELLITE_MAX_NATIVE_ZOOM=18
MAP_CUSTOM_LABELS_URL=
MAP_CUSTOM_LABELS_ATTRIBUTION=
