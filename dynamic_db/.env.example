# ---------------------------------------------------------------------------
# DYNAMIC_DB - environment TEMPLATE. Copy to DYNAMIC_DB/.env and fill in.
# Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# ---- Database (read-only access is sufficient) ----
DB_DRIVER=
# e.g. ODBC Driver 18 for SQL Server
DB_SERVER=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_CONNECT_TIMEOUT=15
DB_QUERY_TIMEOUT=60
# Code page used to decode non-Unicode (varchar) columns.
DB_ANSI_CODEPAGE=cp1252

# ---- The approved visibility boundary ----
# An explicit allowlist of "schema.table" names. Only these are introspected,
# only these may appear in a prompt, and only these may be referenced by
# compiled SQL. Empty means nothing is approved, which fails closed.
INCLUDED_TABLES=
# Schemas inside which a REPLACEMENT candidate may be looked for when one of
# the tables above disappears. Discovery never leaves this boundary, and a
# candidate is never adopted without validation and verification.
DISCOVERY_SCHEMAS=
# Extra columns hidden from every prompt, on top of the built-in secret
# filter. "schema.table.column", "table.column", or a bare "column" name.
EXCLUDED_COLUMNS=

# ---- The table ledger: what happened in the database, table by table ----
# Metadata only (names, types, dates, foreign keys), read with the same
# read-only login; the history is kept in DYNAMIC_CACHE_DIR, never in the
# database. A new table is recorded and flagged for review -- it is never
# added to INCLUDED_TABLES automatically.
# Schemas to watch: blank = those INCLUDED_TABLES/DISCOVERY_SCHEMAS reach,
# * = every schema this login can see, or a comma-separated list.
WATCH_SCHEMAS=
# Noise to ignore (schema.table or table-name patterns, * and ?). Blank uses
# the built-in list: tmp_*, *_tmp, temp_*, *_temp, *_bak, *backup*, *_old, ...
WATCH_IGNORE_PATTERNS=
# Minutes between passes while the application runs; 0 turns the in-process
# watcher off (`python -m dynamic_db.cli watch` still works on demand).
WATCH_INTERVAL_MINUTES=60
# Column-name overlap (0-1) at which a new table is flagged as a possible
# successor of an approved one.
WATCH_SIMILARITY_THRESHOLD=0.6

# ---- Compilation behaviour ----
# off    never compile; the caller supplies a baseline for every capability.
# auto   serve the promoted verified artifact; recompile what actually changed.
# strict as auto, but a capability that cannot be re-verified is reported
#        unavailable rather than served from a stale artifact.
DYNAMIC_SQL_MODE=auto
DYNAMIC_CACHE_DIR=.cache
DYNAMIC_MAX_SQL_RETRIES=2
DYNAMIC_MAX_VERIFY_RETRIES=2
DYNAMIC_SAMPLE_ROWS=5
DYNAMIC_EXECUTION_TIMEOUT=120
DYNAMIC_PROFILE_NUMERIC=true

# ---- The reasoning model (SQL authoring + semantic verification) ----
# DYNAMIC_DB has exactly one model role. It has no narration/"fast" model --
# that belongs entirely to whatever application consumes its output.
REASONING_MODEL=
REASONING_PROVIDER=openai
REASONING_BASE_URL=
REASONING_API_KEY=
REASONING_TIMEOUT_SECONDS=180
REASONING_MAX_TOKENS=4000
# Falling back to a weaker model would silently reduce reasoning capability
# on exactly the calls that need it most. Off unless explicitly turned on.
ALLOW_REASONING_FALLBACK=false
REASONING_FALLBACK_MODEL=

# ---- Logging ----
# Relative to DYNAMIC_DB/ unless absolute.
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_CONSOLE=true
# JSON on the console too, instead of the human-readable line format.
LOG_CONSOLE_JSON=false
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
# Days of per-run JSON records (logs/runs/<run_id>.json) kept before pruning.
# 0 disables pruning.
LOG_RETENTION_DAYS=30
